// This is your Prisma schema file for Railway deployment
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  keycloakId String?    @unique
  email      String     @unique
  username   String?
  phone           String?
  birthday        DateTime?
  address         String?
  createdAt  DateTime   @default(now())
  role       Role       @default(USER)
  points     Int        @default(0)
  photos     Photo[]
  analyses   Analysis[]
  reminders  Reminder[]
  subscriptionTier SubscriptionTier @default(FREE)
  conversations Conversation[]
  cart       Cart?
  orders     Order[]
  questionnaire SkinQuestionnaire?
}

enum Role {
  USER
  ADMIN
}

model Photo {
  id        String   @id @default(uuid())
  url       String
  publicId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Analysis {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  skinType    String
  healthScore Int
  skinAge     Int
  summary     String @db.Text

  concerns       Json
  morningRoutine Json
  eveningRoutine Json

  imageUrl  String
  createdAt DateTime @default(now())
}

model Reminder {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String
  time        String
  title       String
  description String?
  enabled     Boolean @default(true)
  days        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SubscriptionTier {
  FREE
  SILVER
  GOLD
  PLATINUM
}

model Article {
  id        String   @id @default(uuid())
  title     String
  category  String
  readTime  Int
  rating    Float
  image     String
  summary   String   @db.Text
  content   String[]
  createdAt DateTime @default(now())
}

model Video {
  id        String   @id @default(uuid())
  title     String
  duration  String
  thumbnail String
  category  String
  url       String
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  name      String
  brand     String
  price     String
  image     String
  url       String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  total     Float
  status    OrderStatus @default(PENDING)
  shipping  Float       @default(0)
  tax       Float       @default(0)
  trackingNumber String?
  shippingAddress Json?
  billingAddress  Json?
  paymentMethod   Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name      String
  brand     String
  price     String
  image     String
  url       String?
  quantity  Int
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model SkinQuestionnaire {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  skinType         String
  sensitivityLevel String

  symptoms         String[]
  affectedAreas    String[]
  concerns         String[]
  triggers         String[]

  allergies        String?
  medicalHistory   String?
  duration         String
  severity         String
  skincareRoutine  String?

  sunscreenUsage   String?
  stressLevel      String?
  sleepQuality     String?
  waterIntake      String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
